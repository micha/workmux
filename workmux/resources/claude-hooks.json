{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "workmux agent hook claude --pid \"$PPID\" 2>/dev/null || true", "timeout": 5}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "workmux agent hook claude --pid \"$PPID\" 2>/dev/null || true", "timeout": 5}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "workmux agent hook claude --pid \"$PPID\" 2>/dev/null || true", "timeout": 5}]}],
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "workmux agent hook claude --pid \"$PPID\" 2>/dev/null || true", "timeout": 5}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "workmux agent hook claude --pid \"$PPID\" 2>/dev/null || true", "timeout": 5}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "workmux agent hook claude --pid \"$PPID\" 2>/dev/null || true", "timeout": 5}]}],
    "Notification": [{"matcher": "permission_prompt|elicitation_dialog", "hooks": [{"type": "command", "command": "workmux agent hook claude --pid \"$PPID\" 2>/dev/null || true", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "workmux agent hook claude --pid \"$PPID\" 2>/dev/null || true", "timeout": 5}]}]
  }
}
