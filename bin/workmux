#!/usr/bin/env python3
"""Run directly from a checkout; no installation is required."""

import os
import sys
from pathlib import Path

launcher_dir = Path(__file__).resolve().parent
sys.path.insert(0, str(launcher_dir.parent))
# Let tmux's portable bindings find this checkout even when another workmux is installed.
path = os.environ.get("PATH", "")
if path.split(os.pathsep)[0] != str(launcher_dir):
    os.environ["PATH"] = str(launcher_dir) + os.pathsep + path

from workmux.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
